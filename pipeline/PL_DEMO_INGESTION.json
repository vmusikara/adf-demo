				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "Check Source Count",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_EMAIL_DEMO",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"table_name": {
							"value": "@pipeline().parameters.table_name",
							"type": "Expression"
						},
						"status": "FAILED",
						"email_recepient": {
							"value": "@pipeline().globalParameters.email_reccepient",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Read Watermark",
				"type": "Lookup",
				"dependsOn": [],
